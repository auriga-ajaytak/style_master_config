 "html": "<h2 style=\"text-align:center; text-decoration:underline;\">Costing Sheet</h2>\n{% set company = frappe.db.get_single_value(\"Global Defaults\", \"default_company\") %}\n<h3>{{ company }}</h3>\n<div class=\"row section-break\" data-label=\"Style Details\">\n\t\t\t<div class=\"col-xs-6 column-break\">\n\t\t\t\n\t\t\t\t\n\t\t\n\t\t\t<div class=\"row  data-field\" data-fieldname=\"style_number\" data-fieldtype=\"Data\">\n\t\t\t\t<div class=\"col-xs-5\">\n\t\t\t\t\t\n\t\t\t\t\t<label>Buyer: </label>\n\t\t\t\t\t\n\t\t\t\t</div>\n\t\t\t\t<div class=\"col-xs-7\n\t\t\t\t\n\t value\">\n\t\t\t\t\t{{ doc.customer }}\n\t\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\n\t\t\t\n\t\t\t\t\n\t\t\n\t\t\t<div class=\"row  data-field\" data-fieldname=\"style_master_name\" data-fieldtype=\"Data\">\n\t\t\t\t<div class=\"col-xs-5\">\n\t\t\t\t\t\n\t\t\t\t\t<label>Style: </label>\n\t\t\t\t\t\n\t\t\t\t</div>\n\t\t\t\t<div class=\"col-xs-7\n\t\t\t\t\n\t value\">\n\t\t\t\t\t{{ doc.name }}\n\t\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\n\t\t\t\n\t\t\t\t\n\t\t\n\t\t\t<div class=\"row  data-field\" data-fieldname=\"customer\" data-fieldtype=\"Link\">\n\t\t\t\t<div class=\"col-xs-5\">\n\t\t\t\t\t\n\t\t\t\t\t<label>Garment: </label>\n\t\t\t\t\t\n\t\t\t\t</div>\n\t\t\t\t<div class=\"col-xs-7\n\t\t\t\t\n\t value\">\n\t\t\t\t\t{{ doc.name }}\n\t\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\n\t\t\t\n\t\t\t\t\n\t\t\n\t\t\t<div class=\"row  data-field\" data-fieldname=\"quote_for\" data-fieldtype=\"Select\">\n\t\t\t\t<div class=\"col-xs-5\">\n\t\t\t\t\t\n\t\t\t\t\t<label>Order Qty: </label>\n\t\t\t\t\t\n\t\t\t\t</div>\n\t\t\t\t<div class=\"col-xs-7\n\t\t\t\t\n\t value\">\n\t\t\t\t\t{{ doc.garment_qty }}\n\t\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\n\t\t\t\n\t\t\t\t\n\t\t\n\t\t\t<div class=\"row  data-field\" data-fieldname=\"priority\" data-fieldtype=\"Select\">\n\t\t\t\t<div class=\"col-xs-5\">\n\t\t\t\t\t\n\t\t\t\t\t<label>Season: </label>\n\t\t\t\t\t\n\t\t\t\t</div>\n\t\t\t\t<div class=\"col-xs-7 value\">\n\t\t\t\t    {% if doc.season %}\n\t\t\t\t\t{{ doc.season }}\n\t\t\t\t\t{% endif %}\n\t\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\n\t\t\t\n\t\t\t\t\n\t\t\n\t\t\t<div class=\"row  data-field\" data-fieldname=\"country\" data-fieldtype=\"Link\">\n\t\t\t\t<div class=\"col-xs-5\">\n\t\t\t\t\t\n\t\t\t\t\t<label>Quote For: </label>\n\t\t\t\t\t\n\t\t\t\t</div>\n\t\t\t\t<div class=\"col-xs-7\n\t\t\t\t\n\t value\">\n\t\t\t\t\t{{ doc.quote_for }}\n\t\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\n\t\t\t\n\t\t\t\t\n\t\t\n\t\t\t<div class=\"row  data-field\" data-fieldname=\"currency\" data-fieldtype=\"Link\">\n\t\t\t\t<div class=\"col-xs-5\">\n\t\t\t\t\t\n\t\t\t\t\t<label>Quote Date: </label>\n\t\t\t\t\t\n\t\t\t\t</div>\n\t\t\t\t<div class=\"col-xs-7\n\t\t\t\t\n\t value\">\n\t\t\t\t    {{ doc.get_formatted(\"quote_date\") if doc.quote_date }}\n\t\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\n\t\t\t\n\t\t\t\t\n\t\t\n\t\t\t<div class=\"row  data-field\" data-fieldname=\"exchange_rate\" data-fieldtype=\"Float\">\n\t\t\t\t<div class=\"col-xs-5\">\n\t\t\t\t\t\n\t\t\t\t\t<label>Lead Days: </label>\n\t\t\t\t\t\n\t\t\t\t</div>\n\t\t\t\t<div class=\"col-xs-7 value\">\n\t\t\t\t{{ doc.lead_days }}\n\t\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\n\t\t\t\n\t\t\t\t\n\t\t\n\t\t\t<div class=\"row  data-field\" data-fieldname=\"size_series\" data-fieldtype=\"Link\">\n\t\t\t\t<div class=\"col-xs-5\">\n\t\t\t\t\t\n\t\t\t\t\t<label>Size Series: </label>\n\t\t\t\t\t\n\t\t\t\t</div>\n\t\t\t\t<div class=\"col-xs-7\n\t\t\t\t\n\t value\">\n\t\t\t\t{{ doc.size_series }}\n\t\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\n\t\t\t\n\t\t\t</div>\n\t\t\n\t\t\t<div class=\"col-xs-6 column-break\">\n\t\t\t\n\t\t\t\t\n\t\t\n\t\t\t<div class=\"row  data-field\" data-fieldname=\"lead_days\" data-fieldtype=\"Select\">\n\t\t\t\t<div class=\"col-xs-5\">\n\t\t\t\t\t\n\t\t\t\t\t<label>Style Type: </label>\n\t\t\t\t\t\n\t\t\t\t</div>\n\t\t\t\t<div class=\"col-xs-7\n\t\t\t\t\n\t value\">\n\t\t\t\t\t{{ doc.style_type }}\n\t\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\n\t\t\t\n\t\t\t\t\n\t\t\n\t\t\t<div class=\"row  data-field\" data-fieldname=\"garment_qty\" data-fieldtype=\"Float\">\n\t\t\t\t<div class=\"col-xs-5\">\n\t\t\t\t\t\n\t\t\t\t\t<label>Segment: </label>\n\t\t\t\t\t\n\t\t\t\t</div>\n\t\t\t\t<div class=\"col-xs-7 value\">\n\t\t\t\t\t{{ doc.segment }}\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\n\t\t\t<div class=\"row  data-field\" data-fieldname=\"is_set\" data-fieldtype=\"Check\">\n\t\t\t\t<div class=\"col-xs-5\">\n\t\t\t\t\t<label>Priority: </label>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"col-xs-7 value\">\n\t                {{ doc.priority }}\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t\n\t\t\t<div class=\"row  data-field\" data-fieldname=\"is_set\" data-fieldtype=\"Check\">\n\t\t\t\t<div class=\"col-xs-5\">\n\t\t\t\t\t<label>Product Type: </label>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"col-xs-7 value\">\n\t                {{ doc.item }}\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t\n\t\t\t<div class=\"row  data-field\" data-fieldname=\"is_set\" data-fieldtype=\"Check\">\n\t\t\t\t<div class=\"col-xs-5\">\n\t\t\t\t\t<label>Currency: </label>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"col-xs-7 value\">\n\t                {{ doc.currency }}\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t\n\t\t\t<div class=\"row  data-field\" data-fieldname=\"is_set\" data-fieldtype=\"Check\">\n\t\t\t\t<div class=\"col-xs-5\">\n\t\t\t\t\t<label>Ex. Rate: </label>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"col-xs-7 value\">\n\t                {{ doc.exchange_rate }}\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t\n\t\t\t<div class=\"row  data-field\" data-fieldname=\"is_set\" data-fieldtype=\"Check\">\n\t\t\t\t<div class=\"col-xs-5\">\n\t\t\t\t\t<label>Target Price: </label>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"col-xs-7 value\">\n\t                {{ doc.sales_price_target }}\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\n\t\t\t\n\t\t\t</div>\n\t\t\n\t</div>\n\n<table class=\"table table-bordered\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<th>No</th>\n\t\t\t<th>Position</th>\n\t\t\t<th>Material</th>\n\t\t\t<th>Source</th>\n\t\t\t<th>Consumption</th>\n\t\t\t<th>Proc Loss %</th>\n\t\t\t<th>Price/Unit(INR)</th>\n\t\t\t<th>Total(INR)</th>\n\t\t\t<th>Tot.Cost</th>\n\t\t</tr>\n\t\t<tr><td colspan=\"9\"><strong>Fabric Cost Details</strong></td></tr>\n\t\t{% set fabric_total_cost = [] %}\n\t\t{%- for row in doc.fabric_table -%}\n\t\t<tr>\n\t\t\t<td>{{ row.idx }}</td>\n\t\t\t<td>\n\t\t\t    &nbsp;\n\t\t\t</td>\n\t\t\t<td>\n\t\t\t    \t{{ row.fabric_name }}\n\t\t\t</td>\n\t\t\t<td>{{ row.fabric_type }}</td>\n\t\t\t<td>{{ row.total_req_qty }}</td>\n\t\t\t<td>&nbsp;</td>\n\t\t\t<td>\n\t\t\t    {{ row.rate_our }}\n\t\t\t    {% if row.unit != '' -%}\n\t\t\t\t{{ row.unit}}\n\t\t\t\t{%- endif %}\n\t\t    </td>\n\t\t\t<td>{{ row.amount_our }}</td>\n\t\t\t<td>{{ row.amount_our }}</td>\n\t\t\t{% if fabric_total_cost.append(row.amount_our) %}{% endif %}\n\t\t</tr>\n\t\t{%- endfor -%}\n\t\t<tr>\n\t\t    <td colspan=\"7\" style=\"text-align:right;font-weight:bold;\">Total Fabric Cost</td>\n\t\t    <td style=\"font-weight:bold;\">{{_(\"{0}\").format(fabric_total_cost | sum)}}</td>\n\t\t    <td style=\"font-weight:bold;\">{{_(\"{0}\").format(fabric_total_cost | sum)}}</td>\n\t\t</tr>\n\t\t<tr><td colspan=\"9\"><strong>Trims Details</strong></td></tr>\n\t\t{% set trims_total_cost = [] %}\n\t\t{%- for row in doc.trims_table -%}\n\t\t<tr>\n\t\t\t<td>{{ row.idx }}</td>\n\t\t\t<td>\n\t\t\t    &nbsp;\n\t\t\t</td>\n\t\t\t<td>\n\t\t\t    \t{{ row.trim_name }}\n\t\t\t</td>\n\t\t\t<td>{{ row.trims_type }}</td>\n\t\t\t<td>{{ row.total_req_qty }}</td>\n\t\t\t<td>&nbsp;</td>\n\t\t\t<td>\n\t\t\t    {{ row.rate_our }}\n\t\t\t    {% if row.unit != '' -%}\n\t\t\t\t{{ row.unit}}\n\t\t\t\t{%- endif %}\n\t\t    </td>\n\t\t\t<td>{{ row.amount_our }}</td>\n\t\t\t<td>{{ row.amount_our }}</td>\n\t\t\t{% if trims_total_cost.append(row.amount_our) %}{% endif %}\n\t\t</tr>\n\t\t{%- endfor -%}\n\t\t<tr>\n\t\t    <td colspan=\"7\" style=\"text-align:right;font-weight:bold;\">Total Trims Cost</td>\n\t\t    <td style=\"font-weight:bold;\">{{_(\"{0}\").format(trims_total_cost | sum)}}</td>\n\t\t    <td style=\"font-weight:bold;\">{{_(\"{0}\").format(trims_total_cost | sum)}}</td>\n\t\t</tr>\n\t\t<tr><td colspan=\"9\"><strong>Manufacturing Process/Piece</strong></td></tr>\n\t\t{% set mf_total_cost = [] %}\n\t\t{%- for row in doc.manufacturing_cost -%}\n\t\t<tr>\n\t\t\t<td colspan=\"7\" style=\"text-align:right;\">\n\t\t\t    \t{{ row.cost_type }}\n\t\t\t</td>\n\t\t\t<td>{{ row.amount_our }}</td>\n\t\t\t<td>{{ row.amount_our }}</td>\n\t\t\t{% if mf_total_cost.append(row.amount_our) %}{% endif %}\n\t\t</tr>\n\t\t{%- endfor -%}\n\t\t<tr>\n\t\t    <td colspan=\"7\" style=\"text-align:right;font-weight:bold;\">Total Manufacturing Cost</td>\n\t\t    <td style=\"font-weight:bold;\">{{_(\"{0}\").format(mf_total_cost | sum)}}</td>\n\t\t    <td style=\"font-weight:bold;\">{{_(\"{0}\").format(mf_total_cost | sum)}}</td>\n\t\t</tr>\n\t\t<tr><td colspan=\"9\"><strong>Other Cost/Piece</strong></td></tr>\n\t\t{% set ot_total_cost = [] %}\n\t\t{%- for row in doc.other_cost -%}\n\t\t<tr>\n\t\t\t<td colspan=\"7\" style=\"text-align:right;\">\n\t\t\t    \t{{ row.cost_head }}\n\t\t\t</td>\n\t\t\t<td>{{ row.rate_our }}</td>\n\t\t\t<td>{{ row.rate_our }}</td>\n\t\t\t{% if ot_total_cost.append(row.rate_our) %}{% endif %}\n\t\t</tr>\n\t\t{%- endfor -%}\n\t\t<tr>\n\t\t    <td colspan=\"7\" style=\"text-align:right;font-weight:bold;\">Total Other Costs</td>\n\t\t    <td style=\"font-weight:bold;\">{{_(\"{0}\").format(ot_total_cost | sum)}}</td>\n\t\t    <td style=\"font-weight:bold;\">{{_(\"{0}\").format(ot_total_cost | sum)}}</td>\n\t\t</tr>\n\t</tbody>\n</table>",
